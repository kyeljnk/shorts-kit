AI33_API_KEY=

# Search and stock media providers
SERPER_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# fal.ai video generation (blackforestlabs/flux-3-max)
FAL_KEY=

# Gemini Developer API for Argon Agentic Video Understanding (paid tier)
GEMINI_API_KEY=
